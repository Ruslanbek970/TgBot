# Скопируйте этот файл в .env и впишите свои значения.
# .env в git НЕ коммитится.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA-your-token-here

# (необязательно) путь к LibreOffice, если soffice не в PATH
# Windows:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Linux:
# SOFFICE_PATH=/usr/bin/soffice

# (необязательно) ключ для работы ИИ (Gemini API)
# Если не указан, "умный" поиск и генерация описаний будут отключены
# GEMINI_API_KEY=AIzaSy...

# AI provider: gemini or ollama
# For local run without Docker use: OLLAMA_BASE_URL=http://localhost:11434
# For docker compose on Windows/Mac use: OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=60

# Storage backend: postgres или json
STORAGE_BACKEND=postgres

# PostgreSQL для storage/
# Локально без Docker: localhost. В docker compose: db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tgbot_storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
